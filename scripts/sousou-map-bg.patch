+    ctx.globalAlpha = alpha;
+    ctx.imageSmoothingEnabled = false;
+    // world-ish feel: mild parallax so it drifts with the map, still always on-screen
+    const px = dx - Math.floor((cameraX * 0.08) % 24);
+    const py = dy - Math.floor((cameraY * 0.06) % 16);
+    ctx.drawImage(sousouBgImg, 0, 0, sousouBgImg.naturalWidth, sousouBgImg.naturalHeight, px, py, dw, dh);
