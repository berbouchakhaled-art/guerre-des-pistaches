diff --git a/css/mobile.css b/css/mobile.css
index 5fbc4f3..88cba9a 100644
--- a/css/mobile.css
+++ b/css/mobile.css
@@ -227,3 +227,79 @@ html.is-touch #endScreen .level-pick .level-label { grid-column: 1 / -1; }
 html.is-touch #endScreen .level-btn { min-height: 56px; padding: 8px 8px !important; border-radius: 14px; }
 html.is-touch #endScreen .level-btn .lv-name { font-size: 1rem; }
 html.is-touch #endScreen .level-btn .lv-desc { display: none; }
+
+/* =====================================================================
+   TÉLÉPHONE EN PAYSAGE : commandes dans deux colonnes latérales
+   Le jeu est posé entre les colonnes (applyView → --gut-l / --gut-r) :
+   aucun bouton ne recouvre Sousou, les ennemis, le sol ou les trous.
+   ===================================================================== */
+.gut-tip { display: none; }
+body.side-pads.mobile-fs .touch-ui::before,
+body.side-pads.mobile-fs .touch-ui::after {
+  content: ''; position: absolute; top: 0; bottom: 0; pointer-events: none; z-index: 0;
+  background:
+    repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 2px, transparent 2px 10px),
+    repeating-linear-gradient(90deg, rgba(0,0,0,.18) 0 2px, transparent 2px 20px),
+    linear-gradient(180deg, #17321a, #0c1c0e 70%, #09150a);
+}
+body.side-pads.mobile-fs .touch-ui::before {
+  left: 0; width: var(--gut-l, 110px);
+  box-shadow: inset -2px 0 0 #8bc34a, inset -4px 0 0 #1b3a16, inset -10px 0 12px rgba(0,0,0,.35);
+}
+body.side-pads.mobile-fs .touch-ui::after {
+  right: 0; width: var(--gut-r, 110px);
+  box-shadow: inset 2px 0 0 #8bc34a, inset 4px 0 0 #1b3a16, inset 10px 0 12px rgba(0,0,0,.35);
+}
+/* pouce gauche : ▲ ▼ puis ◀ ▶ ; toute la moitié basse de la colonne est tactile */
+body.side-pads.mobile-fs .touch-ui .touch-left {
+  left: 0 !important; bottom: 0 !important;
+  width: var(--gut-l, 110px) !important; max-width: none !important;
+  box-sizing: border-box;
+  padding: 48px 6px max(12px, env(safe-area-inset-bottom)) calc(max(4px, env(safe-area-inset-left)) + 4px);
+  grid-template-columns: 1fr 1fr !important;
+  grid-template-rows: 38px 92px !important;
+  gap: 8px 6px !important;
+}
+body.side-pads.mobile-fs .touch-ui .touch-left .dir-up,
+body.side-pads.mobile-fs .touch-ui .touch-left .dir-down { width: 100% !important; }
+/* pouce droit : TIR au-dessus de SAUT, colonne entière tactile en bas */
+body.side-pads.mobile-fs .touch-ui .touch-right {
+  right: 0 !important; bottom: 0 !important;
+  width: var(--gut-r, 110px); box-sizing: border-box;
+  padding: 0 calc(max(4px, env(safe-area-inset-right)) + 4px) max(12px, env(safe-area-inset-bottom)) 6px;
+  align-items: stretch;
+}
+body.side-pads.mobile-fs .touch-ui .touch-actions {
+  flex-direction: column !important; align-items: center !important; gap: 10px !important;
+  padding-top: 36px;
+}
+body.side-pads.mobile-fs .touch-ui .touch-actions .fire-btn { width: 88px !important; height: 72px !important; margin: 0 !important; }
+body.side-pads.mobile-fs .touch-ui .touch-actions .jump-btn { width: 96px !important; height: 96px !important; margin: 0 !important; }
+/* arme : un seul bouton (l'arme en cours) qui passe à la suivante */
+body.side-pads.mobile-fs .touch-ui .touch-weapons {
+  top: calc(max(6px, env(safe-area-inset-top)) + 2px);
+  right: calc(max(4px, env(safe-area-inset-right)) + 4px) !important;
+}
+body.side-pads.mobile-fs .touch-ui .touch-weapons .tbtn { width: 48px !important; height: 44px !important; }
+body.side-pads.mobile-fs .touch-ui .touch-weapons .tbtn:not(.selected) { display: none !important; }
+body.side-pads.mobile-fs .touch-ui .touch-weapons .tbtn.selected { border-image-source: url(../assets/gfx/btn_dark.png); }
+body.side-pads.mobile-fs.can-fs:not(.is-fs) .fs-btn { right: calc(max(4px, env(safe-area-inset-right)) + 4px + 48px + 6px); }
+/* ☰ et 🔊 en haut de la colonne gauche */
+body.side-pads.mobile-fs .menu-btn { left: calc(max(4px, env(safe-area-inset-left)) + 4px) !important; }
+body.side-pads.mobile-fs .mute-btn {
+  right: auto !important;
+  left: calc(max(4px, env(safe-area-inset-left)) + 4px + 44px + 6px) !important;
+}
+/* astuce du 1er lancement : dans les colonnes, jamais sur le jeu (puis fondu) */
+body.side-pads.mobile-fs .play-hint { display: none !important; }
+body.side-pads.mobile-fs .gut-tip {
+  display: block; position: absolute; top: 30%; box-sizing: border-box;
+  padding: 0 6px; text-align: center; pointer-events: none;
+  font-size: .74rem; font-weight: 800; line-height: 1.35; color: #fff59d;
+  text-shadow: 0 2px 0 rgba(0,0,0,.7);
+  opacity: 0; transition: opacity .5s ease; z-index: 2;
+}
+body.side-pads.mobile-fs .gut-tip.gt-l { left: 0; width: var(--gut-l, 110px); padding-left: calc(max(4px, env(safe-area-inset-left)) + 4px); }
+body.side-pads.mobile-fs .gut-tip.gt-r { right: 0; width: var(--gut-r, 110px); padding-right: calc(max(4px, env(safe-area-inset-right)) + 4px); }
+body.side-pads.mobile-fs #playHint:not(.hidden) ~ #touchUI .gut-tip { opacity: 1; animation: gutTip 1s ease-in-out infinite alternate; }
+@keyframes gutTip { from { transform: translateY(0); } to { transform: translateY(-4px); } }
